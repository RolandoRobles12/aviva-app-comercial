# Google Maps API Key
# Obtén tu API key en: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# HubSpot Private App Token
# Obtén el token en: HubSpot → Configuración → Integraciones → Apps Privadas
VITE_HUBSPOT_API_KEY=tu_hubspot_private_app_token_aqui

# Firebase - Proyecto Registro Aviva (check-ins)
# Necesario para leer check-ins en el reporte de productividad.
# Asegúrate de que las reglas de Firestore del proyecto registro-aviva
# permitan lecturas (allow read: if true) en las colecciones 'users' y 'check-ins'.
VITE_REGISTRO_API_KEY=
VITE_REGISTRO_AUTH_DOMAIN=registro-aviva.firebaseapp.com
VITE_REGISTRO_PROJECT_ID=registro-aviva
VITE_REGISTRO_STORAGE_BUCKET=registro-aviva.firebasestorage.app
VITE_REGISTRO_MESSAGING_SENDER_ID=
VITE_REGISTRO_APP_ID=
