<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa ocupa toda la pantalla -->
    <fragment
        android:id="@+id/mapZone"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Banner de estado en la parte superior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardZoneBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/primary_container">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvZoneDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/secondary_text" />

            <TextView
                android:id="@+id/tvZoneStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando zonas…"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Leyenda en la parte inferior -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Zona asignada -->
            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/legend_dot_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu zona"
                android:textSize="13sp"
                android:textColor="@color/primary_text"
                android:layout_marginEnd="20dp" />

            <!-- Zona prohibida -->
            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/legend_dot_red"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zona prohibida"
                android:textSize="13sp"
                android:textColor="@color/primary_text" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/zoneMapProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

</FrameLayout>
