<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- ══ HEADER ══════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="22dp"
                android:gravity="center_vertical"
                android:background="@drawable/gradient_primary">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Bienvenido!"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/productNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aviva Tu Negocio"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:layout_marginTop="3dp"
                        android:alpha="0.90"
                        android:fontFamily="sans-serif-light" />

                    <TextView
                        android:id="@+id/productSubtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promotores"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:alpha="0.75"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋"
                    android:textSize="40sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ══ FILA 1: Registro + Metas ════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Registro -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegistro"
                android:layout_width="0dp"
                android:layout_height="168dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_registro_bg"
                app:strokeColor="@color/aviva_green"
                app:strokeWidth="1.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/aviva_green">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="⏰"
                            android:textSize="26sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registro"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entrada · Comida · Salida"
                        android:textSize="11sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Metas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMetasComerciales"
                android:layout_width="0dp"
                android:layout_height="168dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/primary_container">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="🎯"
                            android:textSize="26sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textMetasComerciales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis metas"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avance comercial"
                        android:textSize="11sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ══ PROSPECTOS (solo AVIVA_TU_NEGOCIO) ══════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProspectos"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/card_prospectos_bg"
            app:strokeColor="@color/card_prospectos_icon"
            app:strokeWidth="1.5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_prospectos_icon"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="🔍"
                        android:textSize="26sp"
                        android:gravity="center" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prospectos"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar y levantar solicitudes"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/card_prospectos_icon"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ══ FILA 2: Aprendizaje + Asistente ═════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Camino de aprendizaje -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAprendizaje"
                android:layout_width="0dp"
                android:layout_height="158dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_aprendizaje_bg"
                app:strokeColor="@color/warning_color"
                app:strokeWidth="1.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/warning_color">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="📚"
                            android:textSize="26sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camino de"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="aprendizaje"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Asistente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAyuda"
                android:layout_width="0dp"
                android:layout_height="158dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_asistente_bg"
                app:strokeColor="@color/aviva_green"
                app:strokeWidth="1.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/aviva_green">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="💬"
                            android:textSize="26sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asistente"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IA disponible"
                        android:textSize="11sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ══ TRÁMITES (full width, sutil) ════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTramites"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/divider"
            app:strokeWidth="1.5dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/accent_light"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="📄"
                        android:textSize="22sp"
                        android:gravity="center" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trámites"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vacaciones · Aviva days · Incapacidad"
                        android:textSize="11sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-light" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="@color/aviva_green"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
