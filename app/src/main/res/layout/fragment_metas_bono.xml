<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Encabezado ── -->
        <TextView
            android:id="@+id/tvMetasTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis metas"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMetasPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando periodo..."
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:layout_marginBottom="28dp" />

        <!-- ── Tarjeta: Llamadas ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Fila: icono + etiqueta + porcentaje grande -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Llamadas"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text" />

                    <TextView
                        android:id="@+id/tvLlamadasPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                </LinearLayout>

                <!-- Barra de progreso -->
                <ProgressBar
                    android:id="@+id/progressLlamadas"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/primary_container"
                    android:layout_marginBottom="12dp" />

                <!-- Valor actual / meta -->
                <TextView
                    android:id="@+id/tvLlamadasValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- de -- llamadas"
                    android:textSize="15sp"
                    android:textColor="@color/secondary_text" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Tarjeta: Colocación ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Fila: etiqueta + porcentaje grande -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Colocación"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text" />

                    <TextView
                        android:id="@+id/tvColocacionPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                </LinearLayout>

                <!-- Barra de progreso -->
                <ProgressBar
                    android:id="@+id/progressColocacion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/primary_container"
                    android:layout_marginBottom="12dp" />

                <!-- Valor actual / meta -->
                <TextView
                    android:id="@+id/tvColocacionValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="$-- de $--"
                    android:textSize="15sp"
                    android:textColor="@color/secondary_text" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Banner de estado ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_container">

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:gravity="center"
                android:padding="18dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Estado: sin metas / error (oculto por default) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface">

            <TextView
                android:id="@+id/tvNoGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No tienes metas asignadas. Contacta al administrador."
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:padding="24dp"
                android:lineSpacingExtra="4dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
