<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa principal (pantalla completa) -->
    <fragment
        android:id="@+id/zonaMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ─── Barra superior de dibujo (visible solo en modo dibujo) ─── -->
    <LinearLayout
        android:id="@+id/drawingToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E6101828"
        android:padding="12dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca el mapa para agregar vértices de la zona"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <!-- Fila de botones de dibujo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Deshacer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="↩ Deshacer"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:strokeColor="@android:color/white"
                app:cornerRadius="10dp" />

            <!-- Finalizar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishZone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="✓ Finalizar"
                android:textSize="12sp"
                android:backgroundTint="#FF4CAF50"
                app:cornerRadius="10dp" />

            <!-- Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDraw"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="✕ Cancelar"
                android:textColor="#FFFF5252"
                android:textSize="12sp"
                app:strokeColor="#FFFF5252"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ─── Indicador de puntos (visible solo en modo dibujo) ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPointCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:layout_marginTop="140dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#E6101828">

        <TextView
            android:id="@+id/tvPointCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="0 puntos"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ─── Panel inferior de controles (siempre visible) ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomControlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:elevation="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚫 Zonas Prohibidas"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/primary_text" />

                <!-- Botón recargar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReloadZones"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="↻"
                    android:textSize="16sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Botón principal: Dibujar nueva zona -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewZone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Dibujar nueva zona"
                android:textSize="15sp"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
